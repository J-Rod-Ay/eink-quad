# setup-mac.sh writes quad.env for you. If you write it by hand: one KEY=VALUE per line.
TZ=America/New_York
QUAD_TOKEN=
QUAD_ADMIN=
QUAD_CONTACT=you@example.com
QUAD_BIND=127.0.0.1
QUAD_PORT=8740
QUAD_DEVICE_BIND=0.0.0.0
QUAD_DEVICE_PORT=8743
# Optional
# QUAD_CERT=/path/to/quad.crt
# QUAD_KEY=/path/to/quad.key
# QUAD_CONFIG=/path/to/config.json
# QUAD_STATE=/path/to/state.json
# CLAUDE_CODE_OAUTH_TOKEN=...
