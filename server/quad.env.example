# Copy to quad.env, then: set -a; . ./quad.env; set +a; python app.py
TZ=America/New_York
QUAD_PORT=8740
QUAD_BIND=127.0.0.1
QUAD_TOKEN=change-me            # the device's token; must match NOTE_TOKEN in firmware/src/secrets.h
QUAD_ADMIN=change-me-too        # opens the settings page: http://127.0.0.1:8740/?k=<this>
QUAD_CONTACT=you@example.com    # sent in the User-Agent to api.weather.gov, which asks for a contact
# Optional
# QUAD_CONFIG=/path/to/config.json
# QUAD_STATE=/path/to/state.json
# QUAD_NOTES_DB=/path/to/notes.db       # a note-box sqlite to show notes from
# QUAD_NOTEBOX_DIR=/path/to/notebox      # where that note box's render.py lives
# CLAUDE_CODE_OAUTH_TOKEN=...            # for the one-line brief (needs the `claude` CLI); turn off llm_brief otherwise
